// Orthogonal state axes, procedure context replay, closed capture, and claims.
// REPL:
//   :inject DispatchRun Tick
//   :capture DispatchRuntime
//   :replay-procedures
// Named source trace:
//   :trace Happy
//   :claims Happy
function hasCredits(value: int) -> bool:
  value > 0

state SchedulerIdle @ scheduler initial:
  credits: int = 2
  invariant:
    credits >= 0

state SchedulerBusy @ scheduler:
  credits: int = 0
  invariant:
    credits >= 0

state ProcessReady @ process initial:
  started: bool = false

state ProcessRetrying @ process:
  started: bool = false

state ProcessRunning @ process:
  started: bool = true

transition Dispatch():
  case ready (SchedulerIdle @ scheduler, {ProcessReady, ProcessRetrying} @ process) -> (SchedulerBusy @ scheduler, ProcessRunning @ process):
    where:
      hasCredits(scheduler.credits)
    set:
      credits = before.scheduler.credits - 1 @ scheduler
      started = true @ process

procedure DispatchRun @ system:
  initial (SchedulerIdle @ scheduler, ProcessRetrying @ process)

trace Happy:
  replay:
    inject Dispatch() @ DispatchRun -> Dispatch.ready
  capture closed:
    state (SchedulerBusy @ scheduler, ProcessRunning @ process)
    transition (Dispatch.ready)
    procedure (DispatchRun)

trace ProcessView @ system:
  capture projected:
    state (ProcessRunning @ process)
    transition (Dispatch.ready)

Claim DispatchReachesRunning @ Happy:
  eventually:
    process.started

Claim CreditsNeverNegative @ Happy:
  always:
    scheduler.credits >= 0

Claim AtMostOneDispatch @ Happy:
  count Dispatch.ready <= 1
